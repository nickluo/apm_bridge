<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schemans="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apm_bridge</name>
  <version>1.0.0</version>
  <description>ROS2 bridge to a customized Betaflight FC via its dedicated binary link (custom_link), with direct XFrobot gimbal (C-20S) support over the vendor private protocol</description>
  <maintainer email="tianqiluo@deepglint.com">nick.luo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>mavros_msgs</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
